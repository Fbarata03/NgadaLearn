# ═══════════════════════════════════════════════════
# NgadaLearn Frontend — Variáveis de Ambiente
# Copiar para .env.local e preencher os valores reais
# ═══════════════════════════════════════════════════

# URL da API backend (Render ou localhost)
VITE_API_URL=https://ngadalearn-api.onrender.com

# Chave pública do Stripe (pk_live_... ou pk_test_...)
# Obter em: dashboard.stripe.com → Developers → API keys
VITE_STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# YouTube Data API v3 (opcional — para pesquisa de vídeos)
# Obter em: console.cloud.google.com → APIs → YouTube Data API v3
VITE_YOUTUBE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Deepgram API (Prática de Conversação ao Vivo — STT + TTS)
# Obter em: console.deepgram.com → API Keys
# ATENÇÃO: nunca comitas esta chave para o git!
VITE_DEEPGRAM_KEY=AQ.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
