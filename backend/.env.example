# ═══════════════════════════════════════════════════
# NgadaLearn Backend — Variáveis de Ambiente
# Copiar para .env e preencher os valores reais
# ═══════════════════════════════════════════════════

# Servidor
PORT=3001
NODE_ENV=development

# Neon PostgreSQL — connection string completa
# Obtém em: console.neon.tech → Project → Connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# JWT
JWT_SECRET=muda_este_segredo_para_producao_123!
JWT_EXPIRES_IN=7d

# CORS — origem do frontend
FRONTEND_URL=http://localhost:5173

# Spotify API (Client Credentials — nunca expor o Secret no frontend!)
SPOTIFY_CLIENT_ID=o_teu_client_id
SPOTIFY_CLIENT_SECRET=o_teu_client_secret

# Admin inicial (criado no seed automático)
# Substituir pelos teus valores reais no .env (nunca no .env.example)
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=escolhe_uma_password_forte_aqui
